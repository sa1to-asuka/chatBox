NODE_ENV=production
HOST=127.0.0.1
PORT=3006
DATA_DIR=./data
STATIC_DIR=./dist
COOKIE_SECURE=true
TRUST_PROXY=true
# 必填：至少 32 个随机字符；用于加密数据库中的供应商 API Key。生成后不要更换，否则旧密钥无法解密。
CONFIG_SECRET=replace-with-at-least-32-random-characters
# 默认关闭公开注册（由管理员在后台创建账号）。需要临时开放时设为 1。
# ALLOW_REGISTRATION=1
# 联网智能体总开关；设为 0 可回退到单次模型调用。
# AGENT_ENABLED=1
# 可选：PPT Master 原生 SVG → PPTX 渲染；不设置时自动使用 PptxGenJS。
# PPTMASTER_PYTHON=/path/to/ppt-master/.venv/bin/python
# PPTMASTER_HOME=/path/to/ppt-master/skills/ppt-master
