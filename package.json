{
  "name": "chatbox",
  "version": "0.2.0",
  "description": "Chatbox：带账户、模型权限与每日积分的私人 AI 聊天工作空间。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "server": "tsx server/index.ts",
    "server:type": "tsc -p tsconfig.server.json",
    "test:integration": "tsx server/integration-test.ts",
    "mock:upstream": "node scripts/mock-upstream.mjs",
    "admin:create": "tsx server/create-admin.ts",
    "build": "rspack build -c rspack.config.ts",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write .",
    "server:build": "tsc -p tsconfig.build.json",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.11",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "better-sqlite3": "^13.2.0",
    "clsx": "2.1.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mammoth": "^1.13.0",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "openai": "^7.57.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "unpdf": "^2.2.0",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "~25.9.9",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
